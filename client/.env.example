# Backend API Base URL (leave blank or http://localhost:5000 in local development; on Vercel set to your Render URL: e.g. https://schemematch-api.onrender.com)
VITE_API_URL=http://localhost:5000

# Supabase Cloud Configuration
# Replace these with your project credentials from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
